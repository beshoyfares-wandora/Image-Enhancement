# ===========================================================================
# Backend environment variables
# Copy this file to ".env" and fill in the values.
# ===========================================================================

# Server
PORT=4000
NODE_ENV=development

# Comma-separated list of allowed origins for CORS (the frontend dev server).
CORS_ORIGIN=http://localhost:5173

# Maximum accepted request body size (covers base64-encoded images).
MAX_UPLOAD_SIZE=25mb

# ---------------------------------------------------------------------------
# Requesty (https://requesty.ai) - OpenAI-compatible router used for every
# model call. Get your key from the Requesty dashboard.
# ---------------------------------------------------------------------------
REQUESTY_API_KEY=your_requesty_api_key_here
REQUESTY_BASE_URL=https://router.requesty.ai/v1

# Model identifiers routed through Requesty. Update these to match the exact
# model slugs available in your Requesty account.
#  - Claude Opus generates the editing prompt from the uploaded image.
#  - Gemini ("Nano Banana") and GPT Image produce the enhanced images.
# IMPORTANT: the exact slugs (and provider prefix, e.g. "vertex/" vs "google/")
# depend on what your Requesty key is approved for. List yours with:
#   curl https://router.requesty.ai/v1/models -H "Authorization: Bearer <KEY>"
# OpenAI GPT Image models (openai/gpt-image-2) route via the image-edits endpoint
# automatically; Gemini image models route via chat completions.
CLAUDE_PROMPT_MODEL=anthropic/claude-opus-4-8
GEMINI_IMAGE_MODEL=vertex/gemini-2.5-flash-image
GPT_IMAGE_MODEL=openai/gpt-image-2

# Request timeout (ms) for upstream AI calls.
AI_REQUEST_TIMEOUT_MS=300000
