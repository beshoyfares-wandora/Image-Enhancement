# ===========================================================================
# Frontend environment variables (Vite)
# Copy this file to ".env" and adjust if needed.
# Only variables prefixed with VITE_ are exposed to the browser.
# ===========================================================================

# Base URL the frontend uses to reach the backend API.
# Leave as "/api" to use the Vite dev proxy (recommended for local dev).
VITE_API_BASE_URL=/api

# Target the Vite dev server proxies "/api" requests to.
VITE_API_PROXY_TARGET=http://localhost:4000
